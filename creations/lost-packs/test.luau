--!strict
local test = require("@potluck/test@0.7")
local world = require("@potluck/world@0.21")

local CARRY = { Cobblestone = 10, Planks = 3 }

test.case("on a Gentle world you keep what you carry", function()
	local p = test.player("Ada", { survival = true, carrying = CARRY })
	world.hurt(p, 20)
	test.wait(0.5)
	test.same(world.has(p, "Cobblestone"), 10, "still carried")
	test.same(world.find_block(p.position, 4, "Lost pack"), nil, "no pack")
end)

test.case("on a Normal world what you carried waits in a pack where you fell", function()
	test.danger("normal")
	local p = test.player("Ada", { survival = true, carrying = CARRY })
	world.hurt(p, 20)
	test.wait(0.5)
	test.same(world.has(p, "Cobblestone"), 0, "dropped")
	local pack = world.find_block(p.position, 4, "Lost pack")
	test.check(pack ~= nil, "a pack where they fell")
	test.use_block(p, pack :: vector)
	test.same(world.has(p, "Cobblestone"), 10, "the stone back")
	test.same(world.has(p, "Planks"), 3, "the planks back")
	test.same(world.block(pack :: vector), "Air", "the pack's gone")
end)

test.case("anyone can open a pack, but not from creative", function()
	test.danger("hard")
	local p = test.player("Ada", { survival = true, carrying = CARRY })
	world.hurt(p, 20)
	test.wait(0.5)
	local pack = world.find_block(p.position, 4, "Lost pack") :: vector
	test.check(pack ~= nil, "a pack")
	local c = test.player("Cy")
	test.dig(c, pack)
	test.same(world.block(pack), "Lost pack", "still there after a creative player broke it")
	local b = test.player("Bo", { survival = true })
	test.dig(b, pack)
	test.same(world.has(b, "Cobblestone"), 10, "Bo has the stone")
	test.same(world.block(pack), "Air", "and the pack's gone")
end)

test.case("Peaceful keeps what you carry too", function()
	test.danger("peaceful")
	local p = test.player("Ada", { survival = true, carrying = CARRY })
	world.hurt(p, 20)
	test.wait(0.5)
	test.same(world.has(p, "Planks"), 3, "kept")
end)
