--!strict
-- Bows, slings and spears' own tests: `potluck-server --test=ranged`.

local test = require("@potluck/test@0.6")
local world = require("@potluck/world@0.19")

local AHEAD = vector.create(1, 0.2, 0)

test.case("a bow shoots an arrow you carry, and waits a moment for the next", function()
	local p = test.player("Ada", { survival = true, carrying = { Bow = 1, Arrow = 3 } })
	test.hold(p, "Bow")
	test.use_item(p, AHEAD)
	test.use_item(p, AHEAD)
	test.same(test.heard("twang"), 1, "one shot, the second too soon")
	test.same(world.has(p, "Arrow"), 2, "the arrow it shot")
	test.wait(1)
	test.use_item(p, AHEAD)
	test.same(test.heard("twang"), 2, "and the next")
end)

test.case("with nothing to shoot, it says so", function()
	local p = test.player("Ada", { survival = true, carrying = { Bow = 1, Sling = 1 } })
	test.hold(p, "Bow")
	test.use_item(p, AHEAD)
	test.same(test.heard("twang"), 0, "no arrows, no shot")
	test.check(string.find(test.shown(p, "ranged") or "", "You've no arrows to shoot.", 1, true) ~= nil, test.shown(p, "ranged") or "")
	test.hold(p, "Sling")
	test.use_item(p, AHEAD)
	test.same(test.heard("whirr"), 0, "no stones either")
end)

test.case("a sling throws cobblestone", function()
	local p = test.player("Ada", { survival = true, carrying = { Sling = 1, Cobblestone = 2 } })
	test.hold(p, "Sling")
	test.use_item(p, AHEAD)
	test.same(test.heard("whirr"), 1)
	test.same(world.has(p, "Cobblestone"), 1, "the stone it threw")
end)

test.case("a spear flies one at a time and stays yours", function()
	local p = test.player("Ada", { survival = true, carrying = { Spear = 1 } })
	test.hold(p, "Spear")
	test.use_item(p, vector.create(0, 1, 0))
	test.wait(0.8)
	test.use_item(p, AHEAD)
	test.same(test.heard("whoosh"), 1, "not while the first is in the air")
	test.same(world.has(p, "Spear"), 1, "still yours")
	test.wait(6)
	test.use_item(p, AHEAD)
	test.same(test.heard("whoosh"), 2, "once it's down")
end)

test.case("in creative a bow needs no arrows", function()
	local p = test.player("Bo")
	test.hold(p, "Bow")
	test.use_item(p, AHEAD)
	test.same(test.heard("twang"), 1)
end)
